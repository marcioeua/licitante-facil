# Copie para .env e ajuste. Em produção, SESSION_SECRET é obrigatório.
PORT=3333
# SESSION_SECRET: opcional; se vazio, é gerado e guardado no banco no primeiro início
SESSION_SECRET=
DB_PATH=./data/licitante.db
UPLOAD_DIR=./data/uploads
APP_URL=https://seu-dominio.com.br

# E-mail dos alertas (qualquer SMTP: Gmail, Brevo, Amazon SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Busca Pregão IA <alertas@seu-dominio.com.br>"

# Leitura de editais com IA (Claude). Crie a chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo usado (padrão claude-opus-5-5) e limite de análises por usuário por dia
# ANTHROPIC_MODEL=claude-opus-5-5
# IA_LIMITE_DIARIO=30

# Cadastro: em produção fecha após a primeira conta. Libere com código de convite ou abra a todos.
CODIGO_CONVITE=
# CADASTRO_ABERTO=true
# AGENDADOR=off   # desliga a atualização automática do PNCP e os alertas

# Histórico de compras: dias de contratos guardados (cerca de 250 MB de disco por mês)
# HISTORICO_DIAS=30
